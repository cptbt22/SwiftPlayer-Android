<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SwiftPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorError">@color/error</item>
        <!-- M3 表面容器角色：确保 TextInputLayout / 菜单 / BottomSheet 等具备深色底（区别于旧的 surface 变体） -->
        <item name="colorSurfaceContainerLowest">@color/background</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorSurfaceDim">@color/background</item>
        <item name="colorSurfaceBright">@color/surface_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialAlertDialogTheme">@style/Theme.SwiftPlayer.AlertDialog</item>
    </style>

    <style name="Theme.SwiftPlayer.Player">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.SwiftPlayer.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <!-- 保险层：显式补齐 M3 角色，避免浅色系统模式下输入框变浅底导致「白底白字」 -->
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
    </style>

    <style name="RoundedCorner8" parent="">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="RoundedCorner10" parent="">
        <item name="cornerSize">10dp</item>
    </style>

    <style name="RoundedCorner14" parent="">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="RoundedCorner12" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="RoundedCorner16" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="RoundedCorner28" parent="">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="GestureIndicator">
        <item name="android:background">@drawable/bg_gesture_indicator</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- Emby 视觉 -->
    <style name="EmbyPosterCard" parent="">
        <item name="cardCornerRadius">12dp</item>
    </style>

    <style name="TextAppearance.SwiftPlayer.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
